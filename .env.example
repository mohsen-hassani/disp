# Copy to .env and fill in real values. Never commit .env.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Required ---
DISP_DATABASE_URL=postgresql+asyncpg://disp:disp@localhost:5432/disp
DISP_JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
DISP_SETTINGS_KEY=change-me-to-a-fernet-generate_key-output
DISP_BASE_URL=http://localhost:8000

# --- Optional (defaults shown) ---
# DISP_DATABASE_URL_SYNC is derived from DISP_DATABASE_URL if unset.
# DISP_DATABASE_URL_SYNC=postgresql+psycopg://disp:disp@localhost:5432/disp
DISP_ACCESS_TOKEN_TTL_SECONDS=900
DISP_REFRESH_TOKEN_TTL_SECONDS=2592000
DISP_INVITE_TTL_SECONDS=604800
# DISP_PAT_DEFAULT_TTL_DAYS=
DISP_MODULES=
DISP_CORS_ORIGINS=
DISP_COOKIE_SECURE=true
# DISP_COOKIE_DOMAIN=
DISP_LOG_LEVEL=INFO
DISP_LOG_FORMAT=json
DISP_DAILY_PLANNER_CRON=0 6 * * *
DISP_TIMEZONE=Europe/Amsterdam
DISP_RATE_LIMIT_ENABLED=true
DISP_ENV=production

# --- plants module ---
# Where plant photos are written. Relative paths resolve against the process
# CWD (repo root under `uv run`); docker-compose.yml overrides this to
# /data/media/plants on the `media` volume.
DISP_PLANTS_MEDIA_ROOT=var/media/plants
DISP_PLANTS_MAX_IMAGE_BYTES=2097152

# --- docker-compose only ---
POSTGRES_PASSWORD=change-me
PUBLIC_HOST=disp.example.com
ACME_EMAIL=you@example.com

# --- disp-admin seed-admin only ---
# DISP_SEED_PASSWORD=
