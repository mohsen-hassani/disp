# Copy to .env and fill in real values. Never commit .env.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Required ---
DISP_DATABASE_URL=postgresql+asyncpg://disp_user:disp@localhost:5432/disp_db
DISP_JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
DISP_SETTINGS_KEY=change-me-to-a-fernet-generate_key-output
DISP_BASE_URL=http://localhost:8000

# --- Optional (defaults shown) ---
# DISP_DATABASE_URL_SYNC is derived from DISP_DATABASE_URL if unset.
# DISP_DATABASE_URL_SYNC=postgresql+psycopg://disp_user:disp@localhost:5432/disp_db
DISP_ACCESS_TOKEN_TTL_SECONDS=900
DISP_REFRESH_TOKEN_TTL_SECONDS=2592000
DISP_INVITE_TTL_SECONDS=604800
# DISP_PAT_DEFAULT_TTL_DAYS=
DISP_MODULES=
DISP_CORS_ORIGINS=
DISP_COOKIE_SECURE=true
# DISP_COOKIE_DOMAIN=
DISP_LOG_LEVEL=INFO
DISP_LOG_FORMAT=json
DISP_DAILY_PLANNER_CRON=0 6 * * *
DISP_TIMEZONE=Europe/Amsterdam
DISP_RATE_LIMIT_ENABLED=true
DISP_ENV=production

# --- core file service (M18-files.md) — S3-compatible object storage only ---
# Values below point at the MinIO bucket `./dev up` starts (docker-compose.test.yml).
# Production: Cloudflare R2 — see docs/operations.md "File storage". NEVER point a
# non-production database at the production bucket: the sweeper deletes objects
# that have no row in its own database.
DISP_FILES_BACKEND=s3
DISP_FILES_S3_BUCKET=disp-dev
DISP_FILES_S3_ENDPOINT_URL=http://localhost:9000
# Host signed links point at, if the browser reaches the bucket by another name.
# DISP_FILES_S3_PUBLIC_ENDPOINT_URL=
DISP_FILES_S3_REGION=us-east-1
DISP_FILES_S3_ACCESS_KEY_ID=minioadmin
DISP_FILES_S3_SECRET_ACCESS_KEY=minioadmin
DISP_FILES_S3_PREFIX=
DISP_FILES_S3_FORCE_PATH_STYLE=true
DISP_FILES_MAX_BYTES=104857600
DISP_FILES_DEFAULT_LINK_TTL_SECONDS=3600
DISP_FILES_ORPHAN_GRACE_SECONDS=3600
DISP_FILES_SWEEP_CRON=17 * * * *

# --- core translation service (M22-translation.md) ---
# Disabled by default: with DISP_TRANSLATION_ENABLED=false the facade raises
# TranslationNotConfigured and no backend is constructed, so no key is needed.
# The `fake` backend needs no key either, which is what lets a hermetic dev or
# test deployment turn translation on.
DISP_TRANSLATION_ENABLED=false
DISP_TRANSLATION_BACKEND=deepl
# DISP_TRANSLATION_API_KEY=
# Leave empty to derive the host from the key: a free-tier key ends in ":fx"
# and must reach api-free.deepl.com, a pro key api.deepl.com. Set this only
# for a self-hosted proxy — and remember to clear it if you swap a free key
# for a pro one, or every call 403s.
# DISP_TRANSLATION_BASE_URL=
# DISP_TRANSLATION_DEFAULT_TARGET_LANG=
DISP_TRANSLATION_TIMEOUT_SECONDS=30
DISP_TRANSLATION_MAX_RETRIES=2
DISP_TRANSLATION_MAX_CHARS=120000

# --- plants module ---
DISP_PLANTS_MAX_IMAGE_BYTES=2097152

# --- docker-compose only ---
# ACME_EMAIL is not here: that's consumed by Traefik, which now lives in the
# separate infra project (../infra/.env.example), not this repo.
POSTGRES_PASSWORD=change-me
PUBLIC_HOST=disp.example.com

# --- production deploy only ---
# Consumed by docker-compose.prod.yml to resolve the image references
# (${IMAGE_REGISTRY}/disp:${IMAGE_TAG} and .../disp-web:${IMAGE_TAG}).
# IMAGE_TAG is managed automatically
# by scripts/deploy.sh on every deploy — set it once to any value here
# so the file exists before the first deploy; IMAGE_REGISTRY is set once by
# hand and includes any registry namespace/project path, not just the host
# (e.g. registry.mohsen-hassani.com/mohsen_hassani).
IMAGE_REGISTRY=registry.mohsen-hassani.com/mohsen_hassani
IMAGE_TAG=latest

# --- disp-admin seed-admin only ---
# DISP_SEED_PASSWORD=
