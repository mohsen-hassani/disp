# Copy to .env and fill in real values. Never commit .env.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Required ---
MYSTUFF_DATABASE_URL=postgresql+asyncpg://disp:disp@localhost:5432/disp
MYSTUFF_JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
MYSTUFF_SETTINGS_KEY=change-me-to-a-fernet-generate_key-output
MYSTUFF_BASE_URL=http://localhost:8000

# --- Optional (defaults shown) ---
# MYSTUFF_DATABASE_URL_SYNC is derived from MYSTUFF_DATABASE_URL if unset.
# MYSTUFF_DATABASE_URL_SYNC=postgresql+psycopg://disp:disp@localhost:5432/disp
MYSTUFF_ACCESS_TOKEN_TTL_SECONDS=900
MYSTUFF_REFRESH_TOKEN_TTL_SECONDS=2592000
MYSTUFF_INVITE_TTL_SECONDS=604800
# MYSTUFF_PAT_DEFAULT_TTL_DAYS=
MYSTUFF_MODULES=
MYSTUFF_CORS_ORIGINS=
MYSTUFF_COOKIE_SECURE=true
# MYSTUFF_COOKIE_DOMAIN=
MYSTUFF_LOG_LEVEL=INFO
MYSTUFF_LOG_FORMAT=json
MYSTUFF_DAILY_PLANNER_CRON=0 6 * * *
MYSTUFF_TIMEZONE=Europe/Amsterdam
MYSTUFF_RATE_LIMIT_ENABLED=true
MYSTUFF_ENV=production

# --- docker-compose only ---
POSTGRES_PASSWORD=change-me
PUBLIC_HOST=stuff.example.com
ACME_EMAIL=you@example.com

# --- disp-admin seed-admin only ---
# MYSTUFF_SEED_PASSWORD=
